# ---- Supabase ----
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Grading + generation model (server routes only) ----
# Any Anthropic-compatible endpoint. Leave LLM_BASE_URL unset for Anthropic.
#
# Kimi:      LLM_BASE_URL=https://api.kimi.com/coding
#            LLM_MODEL=kimi-for-coding   (or kimi-k2-turbo-preview)
# Anthropic: leave LLM_BASE_URL unset, LLM_MODEL=claude-opus-5
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Legacy names, still honoured as a fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Reasoning before answering. Defaults to on: with it off, Kimi returns values
# outside the closed enums and the response is rejected. Only set this to
# "disabled" if your provider still respects the schema without it.
LLM_THINKING=adaptive

# ---- Whisper transcription (server route only) ----
# Any OpenAI-compatible /audio/transcriptions endpoint (OpenAI, Groq, self-hosted whisper.cpp).
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_API_KEY=sk-...
WHISPER_MODEL=whisper-1

# ---- Audio storage ----
# Supabase Storage bucket used for voice attempts (30-day retention).
SUPABASE_AUDIO_BUCKET=attempt-audio
# Service role key: required only for uploading audio + running the retention sweep.
SUPABASE_SERVICE_ROLE_KEY=
